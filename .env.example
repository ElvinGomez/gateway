# Origins for each microservice (no trailing slash).
# Local: `npm run dev` starts scripts/local-proxy.mjs (default PORT=3080) using these origins.
# Production Vercel: https only.
# Gateway routing: https://vercel.com/docs/project-configuration/vercel-json#routes
# On Vercel, `vercel.json` route `dest` uses ${CDN_ORIGIN} etc.; each route lists `env` so values
# expand at request time. Define these in Project → Settings → Environment Variables.
# Copy to .env for local reference only (not required for `yarn build`).
# Use Production values for production deploys; use Preview (or branch-specific)
# values when you want the gateway preview to hit preview backends.
#
# Root directory for this Vercel project must be `gateway/` (monorepo: set in
# Project → Settings → General → Root Directory).

# PORT=3080
CDN_ORIGIN=http://127.0.0.1:3003
CONFIG_ORIGIN=http://127.0.0.1:3010
POST_ORIGIN=https://api.tripsi.app
FEEDBACK_ORIGIN=http://127.0.0.1:3011
NOTIFICATIONS_ORIGIN=http://127.0.0.1:3012
SPOTS_ORIGIN=http://127.0.0.1:3002
STORIES_ORIGIN=https://api.tripsi.app
USER_MANAGEMENT_ORIGIN=http://127.0.0.1:3050
# Optional — mobile AI (`/v1/ai`, `/v1/conversations`). Production gateway or local tripsi-ai.
AI_ORIGIN=https://api.tripsi.app
